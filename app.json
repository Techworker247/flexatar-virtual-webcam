{
  "expo": {
    "name": "Flexatar Android Control",
    "slug": "flexatar-android-control",
    "version": "0.2.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "newArchEnabled": true,
    "scheme": "flexatar",
    "android": {
      "package": "com.techworker247.flexatar.android",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      "expo-dev-client",
      ["expo-camera", {"cameraPermission": "Allow Flexatar to use the camera.", "microphonePermission": "Allow Flexatar to use the microphone."}],
      ["expo-audio", {"recordAudioAndroid": true}],
      "./plugins/with-flexatar-assets"
    ],
    "runtimeVersion": {"policy": "fingerprint"}
  }
}
